# Copy this file to .env (which git ignores) and fill in the values yourself.

# brief.py --send: Gmail account the brief is sent from.
# GMAIL_APP_PASSWORD is a 16-character Google "app password", not your normal
# Gmail password. Create one at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification turned on).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional: where to send the brief. Defaults to GMAIL_ADDRESS.
BRIEF_TO=

# claude-main.py: Claude commentary on the price table.
ANTHROPIC_API_KEY=
