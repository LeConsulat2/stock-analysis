# Copy to full-flow/.env. Set only the keys used by your chosen route.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Verified documentation IDs on 2026-09-08; account availability is not tested.
OPENAI_MODEL=gpt-6-astra
CLAUDE_MODEL=claude-fable-5-1
GOOGLE_MODEL=gemini-3.8-flash

# Used with --provider mixed. Any role may be assigned to any supported provider.
FUNDAMENTAL_PROVIDER=claude
NEWS_PROVIDER=google
ECOSYSTEM_PROVIDER=google
DECISION_PROVIDER=openai
SKEPTIC_PROVIDER=claude

# Optional per-role model override, including a cheaper specialist model:
# NEWS_MODEL=your-google-model-id
# DECISION_MODEL=gpt-6-astra
# SKEPTIC_MODEL=claude-fable-5-1
